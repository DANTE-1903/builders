{
  "openapi": "3.0.0",
  "info": {
    "title": "Boundless public read API (Boundless Builders)",
    "description": "The public GET routes this app calls, and the schemas they use. Generated from the backend; maintainers update it.",
    "version": "1.0"
  },
  "tags": [],
  "paths": {
    "/api/users/directory": {
      "get": {
        "description": "Paginated, filterable list of listed builders (country, skills, status, search, sort): a public profile with username, avatar and skills, not staff, and at least one piece of real work. Identity and public profile fields only.",
        "operationId": "UserController_getBuildersDirectory",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "country",
            "required": false,
            "in": "query",
            "description": "ISO 3166-1 alpha-2 country code (case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skills",
            "required": false,
            "in": "query",
            "description": "Match builders having any of these skills. Repeat the param or pass a comma-separated list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "AVAILABLE",
                "OPEN_TO_WORK",
                "BUSY",
                "UNAVAILABLE"
              ]
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive match on name or username",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "name_asc",
              "type": "string",
              "enum": [
                "name_asc",
                "name_desc",
                "newest",
                "oldest"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Builders retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildersDirectoryResponseDto"
                }
              }
            }
          }
        },
        "summary": "Public builders directory",
        "tags": [
          "users"
        ]
      }
    },
    "/api/users/filters": {
      "get": {
        "description": "Skills and countries (with counts) across listed builders, plus the status values.",
        "operationId": "UserController_getBuilderFilters",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuilderFiltersDto"
                }
              }
            }
          }
        },
        "summary": "Builders directory filter facets",
        "tags": [
          "users"
        ]
      }
    },
    "/api/users/top-builders": {
      "get": {
        "description": "Listed builders ranked by reputation score. Identity and public profile fields only.",
        "operationId": "UserController_getTopBuilders",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Top builders retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TopBuilderDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Public top builders",
        "tags": [
          "users"
        ]
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "ProjectsController_listPublicProjects",
        "parameters": [
          {
            "name": "creatorId",
            "required": false,
            "in": "query",
            "description": "Filter to a single builder's projects (creator user ID)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organizationId",
            "required": false,
            "in": "query",
            "description": "Filter to a single organization (organization ID)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "required": false,
            "in": "query",
            "description": "Match projects having any of these tags. Repeat the param or pass a comma-separated list.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProjectListDto"
                }
              }
            }
          }
        },
        "summary": "List public projects (PRD products directory)",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/projects/featured": {
      "get": {
        "operationId": "ProjectsController_listFeaturedProjects",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProjectListDto"
                }
              }
            }
          }
        },
        "summary": "List featured projects",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/projects/filters": {
      "get": {
        "description": "Distinct categories and tags (with counts) plus the available public-status and origin-type values.",
        "operationId": "ProjectsController_getProjectFilters",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectFiltersDto"
                }
              }
            }
          }
        },
        "summary": "Project directory filter facets (public)",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/organizations": {
      "get": {
        "description": "Paginated, name-searchable directory of organizations. Public: exposes identity fields and counts only, no member PII.",
        "operationId": "OrganizationsController_getOrganizations",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive match on organization name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "default": "createdAt",
              "type": "string",
              "enum": [
                "createdAt",
                "name"
              ]
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated organizations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicOrganizationListDto"
                }
              }
            }
          }
        },
        "summary": "List public organizations (directory)",
        "tags": [
          "Organization"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BuilderFiltersDto": {
        "type": "object",
        "properties": {
          "skills": {
            "description": "Skills with counts",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCountDto"
            }
          },
          "countries": {
            "description": "Countries with counts",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCountDto"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AVAILABLE",
                "OPEN_TO_WORK",
                "BUSY",
                "UNAVAILABLE"
              ]
            }
          }
        },
        "required": [
          "skills",
          "countries",
          "statuses"
        ]
      },
      "BuilderListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "Null when the builder hid their location"
          },
          "country": {
            "type": "string",
            "nullable": true,
            "description": "Null when the builder hid their location"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "OPEN_TO_WORK",
              "BUSY",
              "UNAVAILABLE"
            ],
            "nullable": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "image",
          "bio",
          "location",
          "country",
          "status",
          "skills",
          "joinedAt"
        ]
      },
      "BuildersDirectoryResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuilderListItemDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "FacetCountDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "value",
          "count"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages",
          "hasNext",
          "hasPrev"
        ]
      },
      "ProjectFiltersDto": {
        "type": "object",
        "properties": {
          "categories": {
            "description": "Categories projects already carry, with counts. A facet for filtering the directory: it describes what exists, so it shrinks to whatever has been filed and is never the list to offer on a create form. Use `categoryOptions` for that.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCountDto"
            }
          },
          "categoryOptions": {
            "description": "The categories a project may be filed under. The vocabulary, not a facet: fixed, independent of what is stored, and the list a create or edit form should render. \"Other\" is the catch-all.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "description": "Most-used tags with counts (capped)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCountDto"
            }
          },
          "publicStatuses": {
            "description": "Available public status values (dev stage)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "originTypes": {
            "description": "Available origin types",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "categories",
          "categoryOptions",
          "tags",
          "publicStatuses",
          "originTypes"
        ]
      },
      "ProjectOriginType": {
        "type": "string",
        "enum": [
          "HACKATHON",
          "GRANT",
          "BOUNTY",
          "CROWDFUNDING",
          "MANUAL"
        ]
      },
      "ProjectPublicStatus": {
        "type": "string",
        "enum": [
          "LIVE",
          "BETA",
          "IN_DEVELOPMENT",
          "ARCHIVED"
        ]
      },
      "ProjectTeam": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "preview": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectTeamPreview"
            }
          }
        },
        "required": [
          "total",
          "preview"
        ]
      },
      "ProjectTeamPreview": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "userId",
          "name",
          "image"
        ]
      },
      "PublicOrganizationListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicOrganizationListItemDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "PublicOrganizationListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "nullable": true,
            "description": "Logo image URL"
          },
          "description": {
            "type": "string",
            "description": "Short description (from about or tagline)"
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "verified": {
            "type": "boolean",
            "description": "Verified organization badge"
          },
          "tags": {
            "description": "Category tag pills",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "membersCount": {
            "type": "number",
            "description": "Total member count"
          },
          "projectsCount": {
            "type": "number",
            "description": "Total projects under this organization"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When the organization was created"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "logoUrl",
          "description",
          "tagline",
          "verified",
          "tags",
          "membersCount",
          "projectsCount",
          "joinedAt"
        ]
      },
      "PublicProjectCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "logo": {
            "type": "string",
            "nullable": true
          },
          "thumbnail": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectPublicStatus"
              }
            ]
          },
          "originType": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectOriginType"
              }
            ]
          },
          "isFeatured": {
            "type": "boolean"
          },
          "projectWebsite": {
            "type": "string",
            "nullable": true
          },
          "liveUrl": {
            "type": "string",
            "nullable": true
          },
          "demoVideo": {
            "type": "string",
            "nullable": true
          },
          "pitchVideoUrl": {
            "type": "string",
            "nullable": true
          },
          "contact": {
            "nullable": true,
            "description": "The contact email the builder published for the project",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicProjectContactDto"
              }
            ]
          },
          "creator": {
            "$ref": "#/components/schemas/PublicProjectCreatorDto"
          },
          "organization": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicProjectOrganizationDto"
              }
            ]
          },
          "_count": {
            "$ref": "#/components/schemas/PublicProjectCountDto"
          },
          "team": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectTeam"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "tagline",
          "summary",
          "description",
          "logo",
          "thumbnail",
          "category",
          "tags",
          "publicStatus",
          "originType",
          "isFeatured",
          "projectWebsite",
          "liveUrl",
          "demoVideo",
          "pitchVideoUrl",
          "contact",
          "creator",
          "organization",
          "_count",
          "team"
        ]
      },
      "PublicProjectContactDto": {
        "type": "object",
        "properties": {
          "primary": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "primary"
        ]
      },
      "PublicProjectCountDto": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "number"
          }
        },
        "required": [
          "comments"
        ]
      },
      "PublicProjectCreatorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "image"
        ]
      },
      "PublicProjectListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicProjectCardDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "PublicProjectOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "TopBuilderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true,
            "description": "Avatar URL"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "Null when the builder hid their location"
          },
          "country": {
            "type": "string",
            "nullable": true,
            "description": "Null when the builder hid their location"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "followers": {
            "type": "number",
            "description": "Number of users following this builder"
          },
          "projects": {
            "type": "number",
            "description": "Published projects the builder created or is a member of"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "image",
          "location",
          "country",
          "skills",
          "followers",
          "projects"
        ]
      }
    }
  }
}